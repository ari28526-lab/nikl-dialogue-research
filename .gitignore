# 2021 진입 전 로컬 archive와 구 검토 payload (정본 보고서는 별도 추적)
/outputs/archive/pre_2021_local_20260803/**
!/outputs/archive/pre_2021_local_20260803/README.md
/outputs/reports/archive/**
/outputs/reviews/archive/**

# 2021–2025 제외 후보의 전수 입력감사 payload는 수십 MB 로컬 근거로 보존한다.
# 작은 후보 manifest·범주 요약·계획 요약은 Git에 추적한다.
/outputs/reviews/mfa_exclusions_queue_mfa_r2_prod_2021_2025_20260803/*/01_input_audit_unapproved.json
# 최초 행 단위 queue는 로컬 역사 근거로만 보존한다. 2021의 이미 추적된 기준선은
# 유지하고, 이후 생성된 구 후보 payload는 현행 safe-body queue와 섞지 않는다.
/outputs/reviews/mfa_exclusions_queue_mfa_r2_prod_2021_2025_20260803/202[2-5]/**
/outputs/reviews/mfa_exclusions_queue_mfa_r2_prod_2021_2025_20260803/CATEGORY_SUMMARY_2021_2025.*
/outputs/reviews/mfa_exclusions_queue_mfa_r2_prod_2021_2025_20260803/PREPARE_SUMMARY.json

# 2020 post-MFA 검토 전달본은 로컬 SHA 근거로 보존하되 payload는 Git 제외
/outputs/reviews/MFA_2020_REVIEW_SIMPLE_V2_20260803/*
!/outputs/reviews/MFA_2020_REVIEW_SIMPLE_V2_20260803/MANIFEST.json
!/outputs/reviews/MFA_2020_REVIEW_SIMPLE_V2_20260803/00_REVIEW.csv
!/outputs/reviews/MFA_2020_REVIEW_SIMPLE_V2_20260803/01_RESEARCHER_APPROVED_AUDIO_UNUSABLE_EXCLUSIONS.csv

# 방법론 재현에 필요한 승인 결정표만 CSV 기본 제외에서 복원
!outputs/reviews/mfa_post_alignment_2020_mfa_r2_prod_2020_20260802/02_RESEARCHER_DECISIONS.csv
!outputs/reviews/mfa_exclusions_queue_mfa_r2_prod_2020_export_20260803/2020/03_RESEARCHER_REVIEW.csv
