        "linked_inter_eojeol_context_span",
        "pending_textgrid_asset_unavailable",
        "pending_textgrid_word_mapping_review"
      ]
    },
    "textgrid_review_need": {
      "required": true,
      "values": ["not_needed", "required", "unsure"]
    },
    "textgrid_asset_status": {
      "required": true,
      "values": ["available", "unavailable", "blocked"]
    },
    "manual_task_status": {
